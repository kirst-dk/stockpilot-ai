# StockPilot AI Environment Configuration

# Mantle Network
DEPLOYER_PRIVATE_KEY=your_wallet_private_key_here
MANTLESCAN_API_KEY=your_mantlescan_api_key
MANTLE_RPC_URL=https://rpc.mantle.xyz

# Deployed StockPilotAgent contract (Mantle Mainnet) — records on-chain yield decisions
STOCKPILOT_CONTRACT_ADDRESS=0xbbE80ACe5c46b49930ff0229762a1A57BE4CA6F4
# ERC-8004 agent identity + reputation + verifiable-AI rationale anchor (Mantle Mainnet)
AGENT_IDENTITY_ADDRESS=0x98611629c106FCf8Dc35A28a2db3a59638DB237a
# Key the backend uses to sign recordYieldDecision txs (defaults to DEPLOYER_PRIVATE_KEY)
AGENT_PRIVATE_KEY=

# RWA / AI Yield Optimizer (USDY by Ondo Finance, on Mantle)
USDY_ORACLE_ADDRESS=0xA96abbe61AfEdEB0D14a20440Ae7100D9aB4882f
USDY_TOKEN_ADDRESS=0x5bE26527e817998A7206475496fDE1E68957c5A6
# ELFA sentiment source (reuses the key-stripping proxy the frontend uses; no key needed)
ELFA_BASE_URL=https://app.stockpilotai.xyz/api/elfa
ELFA_API_KEY=

# Frontend → backend base URL for the RWA Strategy tab "Analyze & Decide" button
# (set in frontend/.env.local as NEXT_PUBLIC_BACKEND_URL; defaults to http://localhost:8000)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Frontend RPC used by the RWA tab to read USDY yield + decision history from Mantle
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.mantle.xyz

# xStocks API (public endpoints work without key)
XSTOCKS_API_KEY=optional_for_authenticated_endpoints

# OpenAI (for AI-enhanced analysis)
OPENAI_API_KEY=your_openai_api_key

# USDC on Mantle
USDC_ADDRESS=0x09Bc4E0D864854c6aFB6eB9A9cdF58aC190D0dF9

# xStock Token Addresses on Mantle (update after fetching from API)
XSTOCK_SPY=
XSTOCK_NVDA=
XSTOCK_AAPL=
XSTOCK_TSLA=
XSTOCK_MSFT=

# --- Autopilot live execution (off by default; simulates swaps unless enabled + funded) ---
AUTOPILOT_LIVE_SWAPS=0
AUTOPILOT_NOTIONAL_USD=
AUTOPILOT_MIN_TRADE_USD=
AUTOPILOT_MAX_TRADE_USD=
AUTOPILOT_ALLOW_SELLS=0
AUTOPILOT_SLIPPAGE_BPS=
AUTOPILOT_INTERVAL_SEC=

# --- USDY routing: Relay (primary meta-aggregator) + Agni multi-hop (fallback) ---
RELAY_ENABLED=1
RELAY_API_BASE=https://api.relay.link
RELAY_QUOTE_URL=https://api.relay.link/quote
RELAY_CHAIN_ID=5000
RELAY_CLIENT_ID=
USDT_ADDRESS=0x201EBa5CC46d216Ce6DC03F6a759e8E766e956aE
USDY_ADDRESS=0x5bE26527e817998A7206475496fDE1E68957c5A6
USDY_MAX_PRICE_IMPACT_BPS=800
USDY_MIN_LEG_USDC=
DEFAULT_SLIPPAGE_BPS=100
FLUXION_SLIPPAGE_BPS=100
# Agni QuoterV2 / SwapRouter (USDC->USDT->USDY exactInput fallback path)
AGNI_QUOTER_V2=0x3E4eE18Ac7280813236a1EB850679Da5322E14CE
AGNI_SWAP_ROUTER=

# --- AI pre-trade compliance gate ---
# Comma-separated OFAC-style denylist of wallet addresses (hard block).
OFAC_DENYLIST=
# Extra restricted region codes appended to the built-in US/sanctioned set.
RESTRICTED_REGIONS_EXTRA=
METH_TOKEN_ADDRESS=0xcDA86A272531e8640cD7F1a92c01839911B90bb0
